[42.092029, "o", "schema nori_rel_example: 2 tables\r\nsnapshot: transaction; read-only: transaction\r\n\r\nusers\r\n  key: user_id\r\n  time column: (none: entity table)\r\n  links: (none)\r\n  columns: user_id BIGINT, created_at TIMESTAMP, country TEXT, income NUMERIC(12, 2)\r\n\r\norders\r\n  key: order_id\r\n  time column: event_time"]
[42.092149, "o", "\r\n  links: user_id -> users\r\n  columns: order_id BIGINT, user_id BIGINT, event_time TIMESTAMP, amount NUMERIC(12, 2)\r\n\r\nPASS: orders is an event table on event_time\r\nPASS: users creation-time candidates: created_at\r\nPASS: event tables linked straight to users: orders\r\n\r\n0 failures\r\n"]
