[116.438251, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GAverage\u001b[13Gper\u001b[17Guser:\u001b[23G78.5.\u001b[33G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBacktest: how it would have done in past months\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BFor \u001b[8Gach mo\u001b[15Gth b\u001b[20Glow, Nori predicted from\u001b[45Gthat cutoff\u001b[57Gusi\u001b[61Gg only\u001b[68Gthe d\u001b[74Gta\u001b[77Gavailable\u001b[87Gthen.\u001b[93GI\u001b[95Gcompared\u001b[104Git\u001b[107Gwith\u001b[112Gwhat\r\u001b[2C\u001b[1Busers\u001b[9Gact\u001b[13Gally\u001b[18Gspent, an\u001b[28G with two simple rules: \"sam\u001b[57G as the user'\u001b[71G p\u001b[74Gevious 30\u001b[84Gdays\"\u001b[90Gand\u001b[94G\"everyone\u001b[104Ggets\u001b[109Gthe\u001b[113Gtypical\r\u001b[2C\u001b[1B(median)\u001b[12Gvalue\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌────────────────────┬───────┬──────────────┬───────────┬──────────────────┬───────────────────┬────────────────┐\r\u001b[2C\u001b[1B│\u001b[24G│\u001b[32G│\u001b[36GAverage\u001b[47G│\u001b[51GAvg\u001b[59G│\u001b[61GAvg\u001b[65Gerror,\u001b[72Gsame\u001b[78G│\u001b[80GAvg\u001b[84Gerror,\u001b[91Gmedian\u001b[98G│\u001b[100GShare\u001b[106Ginside\u001b[115G│\r\u001b[1B \u001b[3G│       Cutoff       │ Users │\u001b[34Gactual\u001b[41Gspend\u001b[47G│\u001b[50Gerror,\u001b[59G│\u001b[61Gas\u001b[64Glast\u001b[69G30\u001b[72Gdays\u001b[78G│\u001b[83Gfor\u001b[87Geveryone\u001b[98G│\u001b[100G10%–90%\u001b[108Grange\u001b[115G│\r\u001b[2C\u001b[1B│\u001b[24G│\u001b[32G│\u001b[47G│\u001b[51GNori\u001b[59G│\u001b[78G│\u001b[98G│\u001b[115G│\r\u001b[1B  ├────────────────────┼───────┼──────────────┼───────────┼──────────────────┼───────────────────┼────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5G2026-01-31\u001b[24G│\u001b[26G48\u001b[32G│\u001b[34G77.97\u001b[47G│\u001b[49G\u001b[1m5.16\u001b[59G\u001b[22m│\u001b[61G5.00\u001b[78G│\u001b[80G17.93\u001b[98G│\u001b[100G0.58\u001b[115G│\r\u001b[2C\u001b[1B├────────────────────┼───────┼──────────────┼───────────┼──────────────────┼───────────────────┼────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G2026-01-01\u001b[24G│\u001b[26G48\u001b[32G│\u001b[34G82.69\u001b[47G│\u001b[49G\u001b[1m5.28\u001b[59G\u001b[22m│\u001b[61G14.49\u001b[78G│\u001b[80G19.83\u001b[98G│\u001b[100G0.75\u001b[115G│\r\u001b[1B \u001b[3G├────────────────────┼───────┼──────────────┼───────────┼──────────────────┼───────────────────┼────────────────┤\r\u001b[1B  │ 2025-12-02   \u001b[19G     │\u001b[26G48   \u001b[32G│\u001b[34G87.27\u001b[47G│\u001b[49G\u001b[1m10.16\u001b[59G\u001b[22m│\u001b[61G14.73\u001b[78G│\u001b[80G24.40\u001b[98G│\u001b[100G0.65\u001b[115G│\r\u001b[2C\u001b[1B├────────────────────┼───────┼──────────────┼───────────┼──────────────────┼───────────────────┼────────────────┤\r\u001b[2C\u001b[1B│ All three (144     │\u001b[32G│\u001b[47G│\u001b[49G\u001b[1m6.87\u001b[59G\u001b[22m│\u001b[61G11.41\u001b[78G│\u001b[80G20.72\u001b[98G│\u001b[115G│\r\u001b[2C\u001b[1B│\u001b[5Gpredictions)\u001b[24G│\u001b[32G│\u001b[47G│\u001b[59G│\u001b[78G│\u001b[98G│\u001b[115G│\r\u001b[1B \u001b[3G└────────────────────┴───────┴──────────────┴───────────┴──────────────────┴───────────────────┴────────────────┘\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOverall, Nori is clearly better.\u001b[38G\u001b[22mIt\u001b[41Gmisses\u001b[48Gby\u001b[51G6.87\u001b[56Gper\u001b[60Guser,\u001b[66Gabout\u001b[72G8%\u001b[75Gof\u001b[78Gaverage\u001b[86Gspend.\u001b[93GRepeating\u001b[103Glast\u001b[108Gmonth\u001b[114Gmisses\r\u001b[1B \u001b[3G  by 11.41, an\u001b[19Gthe median rule by 20.72.\u001b[K\r\u001b[1B  - \u001b[1mOn the most recent month, Nori is no better than repeating l"]
[116.440096, "o", "ast month.\u001b[22m Its average error is 5.16 against\u001b[110G5.00.\r\u001b[4C\u001b[1BNori's big misses are rarer, though: its root-mean-square error (which weights big misses more) is 5.76 against\r\u001b[4C\u001b[1B10.05.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe ranges are too narrow.\u001b[32G\u001b[22mA\u001b[34G10%–90%\u001b[42Grange\u001b[48Gshould\u001b[55Gcontain\u001b[63Gabout\u001b[69G80%\u001b[73Gof\u001b[76Gactual\u001b[83Goutcomes.\u001b[93GThese\u001b[99Gheld\u001b[104G58–75%,\u001b[112Gso\u001b[115Gtreat\r\u001b[1B \u001b[3G  them as optimistic.\u001b[K\r\u001b[1B  -\u001b[K\u001b[36;1H\u001b[34;3H\u001b[?25h"]
