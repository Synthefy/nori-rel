ith the database and local extras is already \u001b[39m     \r\u001b[1B  \u001b[38;2;255;255;255minstalled in this Python.\u001b[39m                                                                                             \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(nori-rel:\u001b[19Getup)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mSuccessfully\u001b[19Gloaded\u001b[26Gskill\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mimport sys\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mfrom importlib.metadata import version\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mfrom nori_rel import NoriRelClient\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153massert (3, 11) <= sys.version_info[:2] <= (3, 13), \"needs Python 3.11 to 3.13\"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mprint(\"python\", sys.version.split()[0])\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mprint(\"nori-rel\", version(\"nori-rel\"))\r\u001b[5C\u001b[1Btry:\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mprint(\"synthefy-nori\", version(…\u001b[39m\u001b[36;1H\u001b[34;3H\u001b[?25h"]
