[19.458407, "o", "\u001b[?25l\u001b[H\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Nori-Rel\u001b[12Gpredicts a number for each row of one table using the tables linked to it. For you, that could be each\u001b[K\r\u001b[2C\u001b[1Bcustomer's\u001b[14Gspend\u001b[20Gover\u001b[25Gthe\u001b[29Gnext\u001b[34G30\u001b[37Gdays,\u001b[43Gworked\u001b[50Gout\u001b[54Gfrom\u001b[59Gtheir\u001b[65Gorders.\u001b[73GNothing\u001b[81Ggets\u001b[86Gtrained.\u001b[95GIt\u001b[98Grebuilds\u001b[107Gwhat\u001b[112Gyour\u001b[117Gdata\r\u001b[1B \u001b[3Glooked like at several past dates, sees what happened\u001b[57Gafter\u001b[63Geach\u001b[68Gone,\u001b[73Gand\u001b[77GNori\u001b[82Glearns\u001b[89Gfrom\u001b[94Gthose\u001b[100Gexamples\u001b[109Gon\u001b[112Gthe\r\u001b[2C\u001b[1Bspot.\r\u001b[1B\u001b[K\r\u001b[1B  The full path has six steps, and I'll check with you before anything that matters:\u001b[K\r\u001b[2B \u001b[3G1. \u001b[1mSetup:\u001b[22m I'l\u001b[17G install the\u001b[30Gright\u001b[36Gextras\u001b[43Gand\u001b[47Gcheck\u001b[53Gthe\u001b[57Genvironment.\u001b[70G\u001b[38;2;177;185;249mnori-rel\u001b[79G\u001b[39m0.4.7\u001b[85Gis\u001b[88Galready\u001b[96Gin\u001b[99Gthis\u001b[104GPython\r\u001b[1B     environment,\u001b[19Gs\u001b[21G this step\u001b[32Gshould\u001b[39Gbe\u001b[42Gquick.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mConnect:\u001b[15G\u001b[22myou\u001b[19Ggive\u001b[24Gme\u001b[27Ga\u001b[29Gread-only\u001b[39Gdatabase\u001b[48Glogin\u001b[54Gthrough\u001b[62Gan\u001b[65Genvironment\u001b[77Gvariable,\u001b[87Gand\u001b[91GI\u001b[93Gcheck\u001b[99Gthat\u001b[104Gyour\u001b[109Gtables\u001b[116Gare\r\u001b[1B \u001b[3G   ready.\u001b[K\r\u001b[1B  3. \u001b[1mPredict:\u001b[22m I turn your question into a Nori-Rel query and you confirm the dates before I run it.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mBacktest:\u001b[22m I predict from earlier dates whose outcome is already known, and compare Nori with two simple rules:\r\u001b[5C\u001b[1B\"repeat\u001b[14Glast\u001b[19Gperiod\"\u001b[27Gand\u001b[31G\"everyone\u001b[41Ggets\u001b[46Gthe\u001b[50Gmedian\".\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mFeatures:\u001b[16G\u001b[22mthis\u001b[21Gonly\u001b[26Ghappens\u001b[34Gif\u001b[37Gthe\u001b[41Gbacktest\u001b[50Glooks\u001b[56Gweak.\r\u001b[2C\u001b[1B6.\u001b[6G\u001b[1mSchedule:\u001b[16G\u001b[22mI\u001b[18Gsave\u001b[23Gthe\u001b[27Gprediction\u001b[38Gso\u001b[41Git\u001b[44Gcan\u001b[48Grerun\u001b[54Gdaily,\u001b[61Gweekly\u001b[68Gor\u001b[71Gmonthly.\r\u001b[2C\u001b[2BTo\u001b[6Gget\u001b[10Gstarted\u001b[18GI\u001b[20Gneed\u001b[25Gthree\u001b[31Ganswers:\r\u001b[2C\u001b[2B1.\u001b[6G\u001b[1mWhat do you want to predict, and over what period?\u001b[57G\u001b[22mOne\u001b[61Gsentence\u001b[70Gis\u001b[73Genough,\u001b[81Glike\u001b[86G\"how\u001b[91Gmuch\u001b[96Geach\u001b[101Gcustomer\u001b[110Gspends\u001b[117Gin\r\u001b[5C\u001b[1Bthe\u001b[10Gnext\u001b[15G30\u001b[18Gdays\"\u001b[24Gor\u001b[27G\"how\u001b[32Gmany\u001b[37Gorders\u001b[44Geach\u001b[49Gcustomer\u001b[58Gplaces\u001b[65Gnext\u001b[70Gmonth.\"\r\u001b[5C\u001b[1B-\u001b[8GNumbers\u001b[16Glike\u001b[21Gspend\u001b[27Gor\u001b[30Gorder\u001b[36Gcount\u001b[42Grun\u001b[46Glocally\u001b[54Gwith\u001b[59Gno\u001b[62Gaccount.\r\u001b[5C\u001b[1B-\u001b[8GA\u001b[10Gyes/no\u001b[17Gtarget\u001b[24Glike\u001b[29G\"will\u001b[35Gthis\u001b[40Gcustomer\u001b[49Gchurn\"\u001b[56Gneeds\u001b[62Ghosted\u001b[69GNori\u001b[74Gand\u001b[78Ga\u001b[80GSynthefy\u001b[89GAPI\u001b[93Gkey.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mWhere is the data?\u001b[25G\u001b[22mPostgreSQL\u001b[36G(including\u001b[47GAWS\u001b[51GRDS\u001b[55Gor\u001b[58GAurora),\u001b[67GSnowflake,\u001b[78GDatabricks,\u001b[90Gor\u001b[93Gexported\u001b[102Gfiles\u001b[108G(CSV,\u001b[114GExcel,\r\u001b[5C\u001b[1BParquet,\u001b[15GJSON).\r\u001b[5C\u001