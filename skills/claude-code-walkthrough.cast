[97.760959, "o", "\u001b[?25l\u001b[H\u001b[3G│ Output                      │ the most likely value, plus a   │ Shows how uncertain each prediction is, and    │\r\u001b[4C\u001b[1B      \u001b[35G10%–90% rang\u001b[48G  \u001b[51G      \u001b[58G    \u001b[63G \u001b[69Gt\u001b[71Ge backtest can check that range  \u001b[105G   \u001b[109G   \r\u001b[2C\u001b[1B├─────────────────────────────┼─────────────────────────────────┼────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Features                    │ FastDFS (the default): built    │                                                │\r\u001b[4C\u001b[1B        \u001b[35Gfrom each user's own orders \r\u001b[2C\u001b[1B└─────────────────────────────┴─────────────────────────────────┴────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gare\u001b[13Gmy\u001b[16Gassumptions:\r\u001b[2C\u001b[1B- Sp\u001b[8Gnd means the \u001b[38;2;177;185;249mamount\u001b[39m column\u001b[35Gas\u001b[38Git\u001b[41Gis:\u001b[45Gevery\u001b[51Gorder\u001b[57Gcounts\u001b[64Gand\u001b[68Gnone\u001b[73Gare\u001b[77Gexcluded.\r\u001b[4C\u001b[1BAll 48 users g\u001b[20Gt a predictio\u001b[34G, \u001b[37Gince they all\u001b[51Gexisted before the start date.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDo these dates and this query look right?\u001b[45G\u001b[22mIf\u001b[48Gyou\u001b[52Gsay\u001b[56Gyes,\u001b[61GI'll\u001b[66Grun\u001b[70Gthe\u001b[74Gprediction\u001b[85Gand\u001b[89Gthen\u001b[94Gthe\u001b[98Gbacktest.\u001b[108GChanges\u001b[116Gare\r\u001b[2C\u001b[1Bfine too, for example a calendar month instead of 30\u001b[56Gdays, or a different start date.\u001b[89G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 58s · done 5:59 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mYes, that is right. Spend is orders.amount, and users.created_at is when a user was created. Go ahead.\u001b[39m                \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(nori-rel:backtest)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mSuccessful\u001b[17Gy load\u001b[24Gd skill\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mBacktest\u001b[12Gthe\u001b[16Gprediction\u001b[27Gon\u001b[30Gthree\u001b[36Gearlier\u001b[44G30-day\u001b[51Gwindows\u001b[38;2;153;153;153m · 3s\r\u001b[1C\u001b[1B ⎿  $ python3 /home/ubuntu/nori-rel-worktrees/public-skills/\u001b[63Gkills/backtest/scripts/backtest.py nori_rel_source.json \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mnori_rel_task.json --folds 3 --out-di\u001b[44G nori_rel_output 2>&1 | grep -v -i \"^progress\\|^\u001b[94Gatus\\|m\u001b[102Gxed \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mprecision\\|it/s\\]\"\u001b[25G| tail -40; echo \"exit ${pipestat\u001b[59Gs[1]}\"\u001b[66G(3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m(ctrl+b ctrl+b (twice) to\u001b[32Grun in background)\u001b[39m\u001b[K\u001b[36;1H\u001b[34;3H\u001b[?25h"]
