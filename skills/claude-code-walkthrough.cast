[151.268572, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BAs a weekly\u001b[15Gcron\u001b[20Gjob,\u001b[25Gfor\u001b[29Gexample\u001b[37Gevery\u001b[43GMonday\u001b[50Gat\u001b[53G06:00\u001b[59GUTC:\r\u001b[2C\u001b[2B0 6 * * 1  \u001b[36mcd\u001b[39m /path/to/project\u001b[34G&&\u001b[37G\\\r\u001b[4C\u001b[1BHF_HUB_OFFLINE=1\u001b[22Gpython\u001b[29Grefresh.py\u001b[40Gnori_rel_source.json\u001b[61Gpipeline.json\u001b[75G\\\r\u001b[2C\u001b[1B  \u001b[6G --as-of\u001b[15G\u001b[31m\"\u001b[39m$D\"\u001b[20G--observed-through \u001b[31m\"\u001b[39m$D\" --t\u001b[48Gsk nori_rel_task.json\u001b[70G\\\r\u001b[6C\u001b[1B--out\u001b[13G\u001b[31m\"predictions_\u001b[39m$D.csv\"\u001b[34G>>\u001b[37Grefresh.log\u001b[49G2>&1\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCopy \u001b[38;2;177;185;249mrefresh.py\u001b[39m,\u001b[22G\u001b[38;2;177;185;249mnori_rel_source.json\u001b[39m, \u001b[38;2;177;185;249mnori_rel_task.json\u001b[39m and \u001b[38;2;177;185;249mpipeline.json\u001b[81G\u001b[39minto\u001b[86Gthe\u001b[90Gjob's\u001b[96Gfolder.\r\u001b[2C\u001b[1B-\u001b[5GGive the job \u001b[38;2;177;185;249mDATABASE_URL\u001b[39m from your secre\u001b[47G \u001b[49Gtore.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mHF_HUB_OFFLINE=1\u001b[39m keeps the job off the network. The\u001b[57Gmodel\u001b[63Gis\u001b[66Galready\u001b[74Gdownloaded\u001b[85Gon\u001b[88Gthis\u001b[93Gmachine.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m$D\u001b[8G\u001b[39mis\u001b[11Gthe\u001b[15Gcompleteness\u001b[28Gdate,\u001b[34Gand\u001b[38Gonly\u001b[43Gyou\u001b[47Gcan\u001b[51Gsay\u001b[55Gwhere\u001b[61Git\u001b[64Gcomes\u001b[70Gfrom.\u001b[76GToday's\u001b[84Gdate\u001b[89Gis\u001b[92Gnot\u001b[96Genough,\u001b[104Gand\u001b[108Gneither\u001b[116Gis\r\u001b[2C\u001b[1B \u001b[5Gthe newest order. A recent order doesn't prove all earlier orders are loaded, and a date that's too\u001b[105Glate\u001b[110Gmakes\u001b[116GNori\r\u001b[2C\u001b[1B \u001b[5Gund\u001b[9Grpr\u001b[13Gdict.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow do you know when your orders are fully loaded?\u001b[22m For example, a nightly lo\u001b[80Gd that finishes\u001b[96Gby 05:00, or a job that\r\u001b[2C\u001b[1Brecords the date it\u001b[23Gloaded \u001b[31Ghrough. T\u001b[41Gll me and I'\u001b[56Gfil\u001b[60G \u001b[38;2;177;185;249m$D\u001b[64G\u001b[39min and\u001b[71Gw\u001b[73Gite th\u001b[80G full comm\u001b[91Gnd.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhen to start over\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mThe command fails with exit code 2:\u001b[22m the save\u001b[51Gsetup can't ru\u001b[69Gymo\u001b[73Ge. That\u001b[81Ghappens when a\u001b[96Gtable\u001b[102Gor\u001b[105Gcolumn\u001b[112Gchanges,\r\u001b[4C\u001b[1Bor\u001b[8Gwhen\u001b[13Gyou\u001b[17Gupgrade\u001b[25G\u001b[38;2;177;185;249mnori-rel\u001b[34G\u001b[39mor\u001b[37Gthe\u001b[41Gmodel.\u001b[48GRun\u001b[52Gthe\u001b[56Gprediction\u001b[67Gagain\u001b[73Gto\u001b[76Gsave\u001b[81Ga\u001b[83Gnew\u001b[87Gsetup,\u001b[94Gand\u001b[98Gbacktest\u001b[107Git\u001b[110Gbefore\r\u001b[2C\u001b[1B  using it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEvery month or so:\u001b[24G\u001b[22mrerun\u001b[30Gthe\u001b[34Gbacktest\u001b[43Gto\u001b[46Gcheck\u001b[52GNori\u001b[57Gstill\u001b[63Gbeats\u001b[69G\"same\u001b[75Gas\u001b[78Glast\u001b[83Gmonth\".\u001b[91GIt\u001b[94Gonly\u001b[99Gedged\u001b[105Gthat\u001b[110Grule\u001b[115Gout\u001b[119Gon\r\u001b[2C\u001b[1B \u001b[5Gmost months, and it tied on the most r\u001b[44Gcent one.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 15s · done 6:02 PM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mI will set observed_through to the day before each run. Give me the final summary.\u001b[39m                         