[160.836574, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B5\u001b[10G12\u001b[14G2\u001b[26G10.16\u001b[44G73\u001b[68G24\u001b[71G40\u001b[97G6\r\u001b[4C\u001b[2BAll three \u001b[18G144\u001b[26G\u001b[1m6.87\u001b[22m \u001b[42G1\u001b[44G41\u001b[69G0\u001b[71G72\u001b[95G    \r\u001b[2C\u001b[1B└\u001b[16G┴\u001b[24G┴\u001b[39G┴\u001b[66G┴\u001b[93G┴\u001b[116G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOverall, Nori's average error is about 8% of average spend, roughly 40% lower than \"same as last month\" and well below\r\u001b[2C\u001b[1B\"median\u001b[11Gfor\u001b[15Geveryone\".\u001b[26GOn\u001b[29Gthe\u001b[33Gmost\u001b[38Grecent\u001b[45Gmonth,\u001b[52Gthough,\u001b[60Git\u001b[63Gties\u001b[68G\"same\u001b[74Gas\u001b[77Glast\u001b[82Gmonth\".\u001b[90GThe\u001b[94G10%–90%\u001b[102Granges\u001b[109Gare\u001b[113Gtoo\r\u001b[2C\u001b[1Bnar\u001b[7Gow: they should contain about 80% of actu\u001b[49Gl outcomes, but held 58–75%. This \u001b[84Gll rests on three months of history.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles\u001b[22m (in thi\u001b[17G fo\u001b[22Ger)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mnori_rel_source.json\u001b[26G\u001b[39mand\u001b[30G\u001b[38;2;177;185;249mnori_rel_task.json\u001b[39m:\u001b[50Gthe\u001b[54Gconnection\u001b[65Gand\u001b[69Gprediction\u001b[80Gsettings.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mnori_rel_output/predictions.csv\u001b[39m:\u001b[38Gone\u001b[42Grow\u001b[46Gper\u001b[50Guser\u001b[55Gwith\u001b[60Gthe\u001b[64Gprediction\u001b[75Gand\u001b[79Gits\u001b[83Grange.\r\u001b[13C\u001b[1B\u001b[38;2;177;185;249moutput/pipeline.json\u001b[39m: the saved setup, ID \u001b[38;2;177;185;249mpipe_802639f9b93138b2\u001b[39m.\u001b[K\r\u001b[20C\u001b[1B\u001b[38;2;177;185;249mbacktest.c\u001b[32Gv\u001b[39m and\u001b[38G\u001b[38;2;177;185;249mnori_rel_output/backtest_rows.csv\u001b[39m: the backtest r\u001b[88Gsults,\u001b[95Gper\u001b[99Gmonth\u001b[105Gand\u001b[109Gper\u001b[113Guser.\r\u001b[20C\u001b[1B\u001b[38;2;177;185;249mcontext.csv\u001b[39m: the pa\u001b[41Gt \u001b[44Gxamples Nori learned from.\u001b[K\r\u001b[4C\u001b[1BRerunning the saved setup for March 2 gave exactly the same 48 predictions.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWeekly job\u001b[22m (Mondays at 06:00 UTC; in a crontab, \u001b[38;2;177;185;249m%\u001b[39m mus\u001b[57G be written \u001b[38;2;177;185;249m\\%\u001b[39m):\u001b[K\r\u001b[2C\u001b[2B0 6 * * 1 \u001b[14G\u001b[36mcd\u001b[39m /p\u001b[20Gth/to/project &&\u001b[37GD=$(\u001b[36mdate\u001b[39m -u -d yesterday +\\%F) && \\\u001b[K\r\u001b[4C\u001b[1BHF_HUB_OFFLINE=1\u001b[22Gpython\u001b[29Grefresh.py\u001b[40Gnori_rel_source.json\u001b[61Gpipeline.json\u001b[75G\\\r\u001b[2C\u001b[1B \u001b[5G \u001b[7G--as-of \u001b[31m\"\u001b[39m$D\" --observed-through \u001b[31m\"\u001b[39m$D\" --task nori_rel_task.json \\\u001b[K\r\u001b[4C\u001b[1B  --out \u001b[31m\"predictions_\u001b[39m$D.csv\" >> refresh.log 2>&1\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCopy \u001b[38;2;177;185;249mrefresh.py\u001b[39m (from \u001b[38;2;177;185;249m/home/ubuntu/nori-rel-worktrees/public-skills/skills/schedule/scripts/\u001b[39m),\u001b[100Gthe\u001b[104Gtwo\u001b[108GJSON\u001b[113Gfiles\r\u001b[4C\u001b[1Band\u001b[9G\u001b[38;2;177;185;249mpipeline.json\u001b[23G\u001b[39mnext\u001b[28Gto\u001b[31Gthe\u001b[35Gjob.\r\u001b[4C\u001b[1BGive\u001b[10Gthe job \u001b[38;2;177;185;249mDATABASE_URL\u001b[39m from your secret store.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThis only works if yesterday's \u001b[37Grders\u001b[43Gare\u001b[47Gfully\u001b[53Gloaded\u001b[60Gbefore\u001b[67G06:00.\u001b[74GIf\u001b[77Gyour\u001b[82Gload\u001b[87Gfinishes\u001b[96Glater,\u001b[103Gmove\u001b[108Gthe\u001b[112Gjob\u001b[116Gafter\r\u001b[2C\u001b[1B \u001b[5Git.\u001b[K\u001b[36;1H\u001b[34;3H\u001b[?25h"]
