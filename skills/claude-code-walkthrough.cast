[105.526559, "o", "\u001b[?25l\u001b[H\u001b[3G│                             │ 10%–90% range                   │ the backtest can check that range              │\r\u001b[2C\u001b[1B├─────────────────────────────┼─────────────────────────────────┼────────────────────────────────────────────────┤\r\u001b[4C\u001b[1BFeatures\u001b[35GFastDFS\u001b[43G(the default):\u001b[58Gbuilt\u001b[69G   \u001b[73G        \u001b[82G   \u001b[86G     \u001b[92G    \u001b[97G     \r\u001b[2C\u001b[1B│                             │ from each user's own orders     │                                                │\r\u001b[2C\u001b[1B└─────────────────────────────┴─────────────────────────────────┴────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese are my assumptions:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSpend\u001b[11Gmeans\u001b[17Gthe\u001b[21G\u001b[38;2;177;185;249mamount\u001b[28G\u001b[39mcolumn\u001b[35Gas\u001b[38Git\u001b[41Gis:\u001b[45Gevery\u001b[51Gorder\u001b[57Gcounts\u001b[64Gand\u001b[68Gnone\u001b[73Gare\u001b[77Gexcluded.\r\u001b[2C\u001b[1B- All\u001b[9G48 users get a prediction,\u001b[36Gsince\u001b[42Gthey\u001b[47Gall\u001b[51Gexisted\u001b[59Gbefore\u001b[66Gthe\u001b[70Gstart\u001b[76Gdate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDo these dates and this query look right?\u001b[22m If you say yes, I'll\u001b[66Grun\u001b[70Gthe prediction\u001b[85Gand\u001b[89Gthen\u001b[94Gthe\u001b[98Gbacktest.\u001b[108GChanges\u001b[116Gare\r\u001b[2C\u001b[1Bfine\u001b[8Gtoo,\u001b[13Gfor\u001b[17Gexample\u001b[25Ga\u001b[27Gcalendar\u001b[36Gmonth\u001b[42Ginstead\u001b[50Gof\u001b[53G30\u001b[56Gdays,\u001b[62Gor\u001b[65Ga\u001b[67Gdifferent\u001b[77Gstart\u001b[83Gdate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 58s · done 5:59 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mYes, that is right. Spend is orders.amount, and users.created_at is when a user was created. Go ahead.\u001b[39m                \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(nori-rel:backtest)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mSuccessfully\u001b[19Gloaded\u001b[26Gskill\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mT\u001b[5Ge prediction and the backtest are done.\u001b[45GNext\u001b[50GI'm\u001b[54Gchecking\u001b[63Gthat\u001b[68Gthe\u001b[72Gsaved\u001b[78Gpipeline\u001b[87Greproduces\u001b[98Gthe\u001b[102Gsame\u001b[107Gpredictions,\r\u001b[1B  then I'll report.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mTinkering…\u001b[39m\u001b[36;1H\u001b[34;3H\u001b[?25h"]
