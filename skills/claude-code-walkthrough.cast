[19.586124, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNori-Rel predicts a number\u001b[30Gfor\u001b[34Geach\u001b[39Grow\u001b[43Gof\u001b[46Gone\u001b[50Gtable\u001b[56Gusing\u001b[62Gthe\u001b[66Gtables\u001b[73Glinked\u001b[80Gto\u001b[83Git.\u001b[87GFor\u001b[91Gyou,\u001b[96Gthat\u001b[101Gcould\u001b[107Gbe\u001b[110Geach\r\u001b[2C\u001b[1Bcustomer's\u001b[14Gspend\u001b[20Gover\u001b[25Gthe\u001b[29Gnext\u001b[34G30\u001b[37Gdays,\u001b[43Gworked\u001b[50Gout\u001b[54Gfrom\u001b[59Gtheir\u001b[65Gorders.\u001b[73GNothing\u001b[81Ggets\u001b[86Gtrained.\u001b[95GIt\u001b[98Grebuilds\u001b[107Gwhat\u001b[112Gyour\u001b[117Gdata\r\u001b[1B \u001b[3Gl\u001b[5Goked \u001b[11Gike at several past dat\u001b[35Gs, sees\u001b[43Gwhat happen\u001b[55Gd after each on\u001b[71G,\u001b[73Gand Nori learns from those examples on t\u001b[114Ge\r\u001b[2C\u001b[1Bspo\u001b[7G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe full\u001b[12Gpath\u001b[17Ghas\u001b[21Gsix\u001b[25Gsteps,\u001b[32Gand\u001b[36GI'll\u001b[41Gcheck\u001b[47Gwith\u001b[52Gyou\u001b[56Gbefore\u001b[63Ganything\u001b[72Gthat\u001b[77Gmatters:\r\u001b[2C\u001b[2B1. \u001b[1mSetup:\u001b[22m I'll install \u001b[27Ghe right\u001b[36Gextras and\u001b[47Gcheck the \u001b[58Gnvironment. \u001b[38;2;177;185;249mnori-rel\u001b[39m 0.4.7 is\u001b[88Galready\u001b[96Gin\u001b[99Gthis\u001b[104GPython\r\u001b[5C\u001b[1Benvironment,\u001b[19Gso\u001b[22Gthis\u001b[27Gstep\u001b[32Gshould\u001b[39Gbe\u001b[42Gquick.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mConnect:\u001b[22m you give me a read-only d\u001b[41Gtabase login through a\u001b[64G \u001b[67Gvironment variable, and I check\u001b[101Gat\u001b[104Gyour tables\u001b[116Gare\r\u001b[5C\u001b[1Bready.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mPredi\u001b[15G\u001b[22mI turn your\u001b[27Gquestion into a Nori-Rel query and\u001b[62Gyou confir\u001b[73G the dates before\u001b[93Grun it.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mBacktest:\u001b[16G\u001b[22mI\u001b[18Gpredict\u001b[26Gfrom\u001b[31Gearlier\u001b[39Gdates\u001b[45Gwhose\u001b[51Goutcome\u001b[59Gis\u001b[62Galready\u001b[70Gknown,\u001b[77Gand\u001b[81Gcompare\u001b[89GNori\u001b[94Gwith\u001b[99Gtwo\u001b[103Gsimple\u001b[110Grules:\r\u001b[2C\u001b[1B  \u001b[6G\"repeat las\u001b[18G peri\u001b[24Gd\"\u001b[27Gand \"everyone\u001b[41Ggets the median\".\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mFeatures\u001b[16G\u001b[22mthis only\u001b[26Ghappens if the backtest l\u001b[52Goks w\u001b[58Gak.\u001b[62G\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6G\u001b[1mSchedule:\u001b[22m I save the\u001b[27Gprediction so\u001b[41Git can rerun daily,\u001b[61Gweekly\u001b[68Gor\u001b[71Gmonthly.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTo\u001b[6Gget started\u001b[18GI n\u001b[22Ged thre\u001b[30G answers:\u001b[K\r\u001b[2C\u001b[2B1.\u001b[6G\u001b[1mWhat do you want to predict, and over what period?\u001b[57G\u001b[22mOne\u001b[61Gsentence\u001b[70Gis\u001b[73Genough,\u001b[81Glike\u001b[86G\"how\u001b[91Gmuch\u001b[96Geach\u001b[101Gcustomer\u001b[110Gspends\u001b[117Gin\r\u001b[5C\u001b[1Bthe\u001b[10Gnext\u001b[15G30\u001b[18Gdays\"\u001b[24Gor\u001b[27G\"how\u001b[32Gmany\u001b[37Gorders\u001b[44Geach\u001b[49Gcustomer\u001b[58Gplaces\u001b[65Gnext\u001b[70Gmonth.\"\r\u001b[2C\u001b[1B  \u001b[6G- Numbers like spend or order count run locally with no account.\u001b[K\r\u001b[5C\u001b[1B- A\u001b[10Gy\u001b[12Gs/no target\u001b[24Glike \"\u001b[31Gill this cu\u001b[43Gtomer\u001b[50Ghurn\" needs host\u001b[67Gd Nori and\u001b[78Ga\u001b[80GSynthefy\u001b[89GAPI\u001b[93Gkey.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mWhere is the data?\u001b[22m PostgreSQL\u001b[36G(includi\u001b[45Gg AWS RDS or Aurora), Snowflake,\u001b[78GDatabricks,\u001b[90Gor\u001b[93Gexported\u001b[102Gfiles\u001b[108G(CSV,\u001b[114GExcel,\r\u001b[5C\u001b[1BParqu\u001b[12Gt, JSON).\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- For a database, can you set\u001b[36Gup a \u001b[1mread-only\u001b[51G\u001b[22mlogin and store\u001b[67Git in \u001b[74Gn environment variable (e.g. \u001b[38;2;177;185;249mDATABASE_URL\u001b[39m) or\u001b[K\r\u001b[5C\u001b[1B  an AWS\u001b[15Gsecret?\u001b[23GPlease\u001b[30Gdon't\u001b[36Gpaste\u001b[42Gthe\u001b[46Gpassword\u001b[55Ghere.\u001b[61GI\u001b[63Gonly\u001b[68Gneed\u001b[73Gthe\u001b[77Gvariable's\u001b[88Gname.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mUp to what date is the data complete?\u001b[22m For example,\u001b[57G\"orders are fully loaded through 2026-10-25.\"\u001b[103GNori-Rel can't\u001b[K\r\u001b[5C\u001b[1Bwork\u001b[11Gthis out from the newes\u001b[36Grow, so you need to tell\u001b[61Gme.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[36;1H\u001b[34;3H\u001b[?25h"]
