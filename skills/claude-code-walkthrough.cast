[82.397346, "o", "\u001b[?25l\u001b[H\u001b[3G│\u001b[33G│\u001b[67G│\u001b[69G\u001b[1m – Apr 1, 2026\u001b[116G\u001b[22m│\r\u001b[2C\u001b[1B├\u001b[33G┼\u001b[67G┼\u001b[116G┤\r\u001b[4C\u001b[1BData\u001b[10Gcomplete through\u001b[35G2026-03-02\u001b[48G     \u001b[69GYou\u001b[73Gsaid\u001b[78Gso\u001b[90G   \r\u001b[2C\u001b[1B│ (\u001b[38;2;177;185;249mobserved_through\u001b[39m)          │                                 │                                                │\r\u001b[2C\u001b[1B├─────────────────────────────┼─────────────────────────────────┼────────────────────────────────────────────────┤\r\u001b[4C\u001b[1BPast\u001b[10Gdates\u001b[16Gto\u001b[19Glearn\u001b[25Gfrom\u001b[35G4:\u001b[38G2026-01-31,\u001b[50G2026-01-01,\u001b[69GOrders only go\u001b[84Gback\u001b[89Gto\u001b[92GSep\u001b[96G2025.\u001b[102GEarlier\u001b[110Gdates\r\u001b[2C\u001b[1B│                             │ 2025-12-02, 2025-11-02          │  would have almost no history to learn from.   │\r\u001b[2C\u001b[1B├─────────────────────────────┼─────────────────────────────────┼────────────────────────────────────────────────┤\r\u001b[4C\u001b[1BExamples Nori learns\u001b[26Gfrom\u001b[35G4\u001b[37G×\u001b[39G48\u001b[42Gusers\u001b[48G=\u001b[50G192,\u001b[55Gwell\u001b[60Gunder\r\u001b[2C\u001b[1B│                             │ the 5,000 cap                   │                                                │\r\u001b[2C\u001b[1B├─────────────────────────────┼─────────────────────────────────┼────────────────────────────────────────────────┤\r\u001b[4C\u001b[1BOutput\u001b[35Gthe most likely value,\u001b[58Gplus\u001b[63Ga\u001b[69GSh\u001b[72Gws how uncertain each prediction is, and \r\u001b[2C\u001b[1B│                             │ 10%–90% range                   │ the backtest can check that range              │\r\u001b[2C\u001b[1B├─────────────────────────────┼─────────────────────────────────┼────────────────────────────────────────────────┤\r\u001b[4C\u001b[1BFeatures\u001b[35GFastDFS (the default):\u001b[58Gbuilt\r\u001b[2C\u001b[1B│                             │ from each user's own orders     │                                                │\r\u001b[2C\u001b[1B└─────────────────────────────┴─────────────────────────────────┴────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese are my assumptions:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSpend means\u001b[17Gthe\u001b[21G\u001b[38;2;177;185;249mamount\u001b[28G\u001b[39mcolumn\u001b[35Gas it is: every order co\u001b[60Gnts\u001b[64Gand none\u001b[73Gare\u001b[77Gexcluded.\u001b[116G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAll\u001b[9G48\u001b[12Gusers\u001b[18Gget\u001b[22Ga\u001b[24Gprediction, sinc\u001b[41G t\u001b[44Gey all existed before\u001b[66Gthe\u001b[70Gstart\u001b[76Gdate.\u001b[116G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDo these dates and this query look right?\u001b[45G\u001b[22mIf\u001b[48Gyou\u001b[52Gsay\u001b[56Gyes,\u001b[61GI'll\u001b[66Grun\u001b[70Gthe\u001b[74Gprediction\u001b[85Gand\u001b[89Gthen\u001b[94Gthe\u001b[98Gbacktest.\u001b[108GChanges\u001b[116Gare\r\u001b[2C\u001b[1Bfine too,\u001b[13Gfor exa\u001b[22Gle a calendar\u001b[36Gmonth\u001b[42Ginstead\u001b[50Gof\u001b[53G30\u001b[56Gdays,\u001b[62Gor\u001b[65Ga\u001b[67Gdifferent\u001b[77Gstart\u001b[83Gdate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 58s · done 5:59 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mYes, that is right. Spend is orders.amount, and users.created_at is when a user was created. Go ahead.\u001b[39m                \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✢\u001b[3GTinkering… \r\u001b[1B\u001b[38"]
