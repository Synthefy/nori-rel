[137.456304, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[38;2;177;185;249m\u001b[1m--observed-through\u001b[22m\u001b[39m is the\u001b[31Gdate you\u001b[40G o\u001b[43Gders are fully loaded through. Set it\u001b[81Gto\u001b[84Gthe\u001b[88Gsame\u001b[93Gdate\u001b[98Gas\u001b[101G\u001b[38;2;177;185;249m--as-of\u001b[39m.\u001b[110GIf\u001b[113Git's\r\u001b[4C\u001b[1Bearlier,\u001b[14Gthe\u001b[18Gmost\u001b[23Grecent\u001b[30Gpast\u001b[35Gmonth\u001b[41Gis\u001b[44Gskipped.\r\u001b[4C\u001b[1BNori learns from \u001b[23Ghe same four\u001b[36Gpast dates, each moved forward to si\u001b[73G 30 days ap\u001b[85Gr\u001b[87G before\u001b[95Gthe\u001b[99Gnew\u001b[103Gdate.\r\u001b[4C\u001b[1BYour Postgres URL is s\u001b[28Gill read from \u001b[38;2;177;185;249mDATABASE_URL\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe command prints\u001b[26Gnu\u001b[29Gber of\u001b[37Gredictions, how\u001b[54Gany past example\u001b[71G it learned from, and an ID\u001b[99G(a hash) for\u001b[112Gthe\u001b[116Gexact\r\u001b[2C\u001b[1Bdata it learn\u001b[17Gd\u001b[19Gfrom. Keep that output. If the number\u001b[57Gof\u001b[60Gpast\u001b[65Gexamples\u001b[74Gsuddenly\u001b[83Gdrops,\u001b[90Gthe\u001b[94Gdata\u001b[99Gbehind\u001b[106Gthe\u001b[110Grun\r\u001b[2C\u001b[1Bchanged.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRun it automatically\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAs\u001b[6Ga\u001b[8Gweekly\u001b[15Gcron\u001b[20Gjob,\u001b[25Gfor\u001b[29Gexample\u001b[37Gevery\u001b[43GMonday\u001b[50Gat\u001b[53G06:00\u001b[59GUTC:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B0\u001b[5G6\u001b[7G*\u001b[9G*\u001b[11G1\u001b[14G\u001b[36mcd\u001b[17G\u001b[39m/path/to/project\u001b[34G&&\u001b[37G\\\r\u001b[2C\u001b[1B  HF_HUB_OFFLINE=1 pyth\u001b[27Gn\u001b[29Grefresh.py nori_rel_source.json pipeline.json\u001b[75G\\\r\u001b[6C\u001b[1B--as-of\u001b[15G\u001b[31m\"\u001b[39m$D\"\u001b[20G--observed-through\u001b[39