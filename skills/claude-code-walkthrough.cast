[116.78232, "o", "\u001b[?25l\u001b[H\u001b[3GFor \u001b[8Gach month b\u001b[20Glow, Nori\u001b[30Gpredicted\u001b[40Gfrom\u001b[45Gthat\u001b[50Gcutoff\u001b[57Gusing\u001b[63Gonly\u001b[68Gthe\u001b[72Gdata\u001b[77Gavailable\u001b[87Gthen.\u001b[93GI\u001b[95Gcompared\u001b[104Git\u001b[107Gwith\u001b[112Gwhat\r\u001b[2C\u001b[1Busers\u001b[9Gactually\u001b[18Gspent,\u001b[25Gand\u001b[29Gwith\u001b[34Gtwo\u001b[38Gsimple\u001b[45Grules:\u001b[52G\"same\u001b[58Gas\u001b[61Gthe\u001b[65Guser's\u001b[72Gprevious\u001b[81G30\u001b[84Gdays\"\u001b[90Gand\u001b[94G\"everyone\u001b[104Ggets\u001b[109Gthe\u001b[113Gtypical\r\u001b[2C\u001b[1B(median) value\".\u001b[K\r\u001b[2C\u001b[2B┌────────────────────┬───────┬──────────────┬───────────┬──────────────────┬───────────────────┬────────────────┐\r\u001b[2C\u001b[1B│    \u001b[9G        \u001b[18G      │   \u001b[29G   │\u001b[34G  Average \u001b[45G  │   Avg   \u001b[58G │\u001b[61GAvg\u001b[65Gerror,\u001b[72Gsame  │ Avg\u001b[84Gerror, median │ Share insid\u001b[113G  │\u001b[K\r\u001b[2C\u001b[1B│       Cutoff  \u001b[24G│\u001b[26GUsers\u001b[32G│\u001b[34Gactual\u001b[41Gspend\u001b[47G│\u001b[50Gerror,\u001b[59G│\u001b[61Gas\u001b[64Glast\u001b[69G30\u001b[72Gdays\u001b[78G│\u001b[83Gfor\u001b[87Geveryone\u001b[98G│\u001b[100G10%–90%\u001b[108Grange\u001b[115G│\r\u001b[2C\u001b[1B│\u001b[24G│\u001b[32G│\u001b[47G│\u001b[51GNori\u001b[59G│\u001b[78G│\u001b[98G│\u001b[115G│\r\u001b[2C\u001b[1B├\u001b[24G┼\u001b[32G┼\u001b[47G┼\u001b[59G┼\u001b[78G┼\u001b[98G┼\u001b[115G┤\r\u001b[4C\u001b[1B2026-01-31\u001b[26G48\u001b[34G77.97    \u001b[49G\u001b[1m5.16\u001b[22m \u001b[61G5.00      \u001b[72G    \u001b[80G17.93     \u001b[91G      \u001b[100G0.58 \u001b[106G      \r\u001b[2C\u001b[1B├────────────────────┼───────┼──────────────┼───────────┼──────────────────┼───────────────────┼────────────────┤\r\u001b[4C\u001b[1B2026-01-01\u001b[26G48\u001b[34G82.69\u001b[49G\u001b[1m5.28\u001b[22m  \u001b[61G14.49\u001b[80G19.