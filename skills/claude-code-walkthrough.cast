[159.315335, "o", "\u001b[?25l\u001b[H\u001b[3G- The predicted\u001b[19Gtotal\u001b[25Gis\u001b[28G3,768.\u001b[35GFebruary's\u001b[46Gactual\u001b[53Gtotal\u001b[59Gwas\u001b[63G3,743.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBacktest\u001b[22m\u001b[K\r\u001b[2C\u001b[2B┌────────────┬───────┬──────────────┬──────────────────────────┬──────────────────────────┬──────────────────────┐\r\u001b[2C\u001b[1B│\u001b[7GCutoff\u001b[16G│\u001b[18GUsers\u001b[24G│\u001b[26GAvg\u001b[30Gerror,\u001b[39G│\u001b[41GAvg\u001b[45Gerror,\u001b[52Gsame\u001b[57Gas\u001b[60Glast\u001b[66G│\u001b[69GAvg\u001b[73Gerror,\u001b[80Gmedian\u001b[87Gfor\u001b[93G│\u001b[95GShare\u001b[101Ginside\u001b[108G10%–90%\u001b[116G│\r\u001b[2C\u001b[1B│            │       │     Nori     │         30 days          │         everyone         │         range        │\r\u001b[2C\u001b[1B├────────────┼───────┼──────────────┼──────────────────────────┼──────────────────────────┼──────────────────────┤\r\u001b[4C\u001b[1B2026-01-31\u001b[18G48\u001b[26G5.16    \u001b[41G5.00\u001b[49G  \u001b[52G    \u001b[68G17.93\u001b[76G        \u001b[95G0.58\u001b[103G     \r\u001b[12C\u001b[2B0\u001b[28G28\u001b[41G14.49\u001b[69G9\u001b[71G8\u001b[97G75\r\u001b[7C\u001b[2B5\u001b[10G12\u001b[14G2\u001b[26G10.16\u001b[44G73\u001b[68G24\u001b[71G40\u001b[97G6\r\u001b[4C\u001b[2BAll three \u001b[18G144\u001b[26G\u001b[1m6.87\u001b[22m \u001b[42G1\u001b[44G41\u001b[69G0\u001b[71G72\u001b[95G    \r\u001b[2C\u001b[1B└\u001b[16G┴\u001b[24G┴\u001b[39G┴\u001b[66G┴\u001b[93G┴\u001b[116G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOverall, Nori's average error is about 8% of average spend, roughly 40% lower than \"same as last month\" and well below\r\u001b[2C\u001b[1B\"median\u001b[11Gfor\u001b[15Geveryone\".\u001b[26GOn\u001b[29Gthe\u001b[33Gmost\u001b[38Grecent\u001b[45Gmonth,\u001b[52Gthough,\u001b[60Git\u001b[63Gties\u001b[68G\"same\u001b[74Gas\u001b[77Glast\u001b[82Gmonth\".\u001b[90GThe\u001b[94G10%–90%\u001b[102Granges\u001b[109Gare\u001b[113Gtoo\r\u001b[2C\u001b[1Bnar\u001b[7Gow: they should contain about 80% of actu\u001b[49Gl outcomes, but held 58–75%. This \u001b[84Gll rests on three months of history.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles\u001b[22m (in thi\u001b[17G fo\u001b[22Ger)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mnori_rel_source.json\u001b[26G\u001b[39mand\u001b[30G\u001b[38;2;177;185;249mnori_rel_task.json\u001b[39m:\u001b[50Gthe\u001b[54Gconnection\u001b[65Gand\u001b[69Gprediction\u001b[80Gsettings.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mnori_rel_output/predictions.csv\u001b[39m:\u001b[38Gone\u001b[42Grow\u001b[46Gper\u001b[50Guser\u001b[55Gwith\u001b[60Gthe\u001b[64Gprediction\u001b[75Gand\u001b[79Gits\u001b[83Grange.\r\u001b[13C\u001b[1B\u001b[38;2;177;185;249moutput/pipeline.json\u001b[39m: the saved setup, ID \u001b[38;2;177;185;249mpipe_802639f9b93138b2\u001b[39m.\u001b[K\r\u001b[20C\u001b[1B\u001b[38;2;177;185;249mbacktest.c\u001b[32Gv\u001b[39m and\u001b[38G\u001b[38;2;177;185;249mnori_rel_output/backtest_rows.csv\u001b[39m: the backtest r\u001b[88Gsults,\u001b[95Gper\u001b[99Gmonth\u001b[105Gand\u001b[109Gper\u001b[113Guser.\r\u001b[20C\u001b[1B\u001b[38;2;177;185;249mcontext.csv\u001b[39m: the pa\u001b[41Gt \u001b[44Gxamples Nori learned from.\u001b[K\r\u001b[4C\u001b[1BRerunning the saved setup for March 2 gave exactly the same 48 predictions.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWeekly job\u001b[22m (Mondays at 06:00 UTC; in a crontab, \u001b[38;2;177;185;249m%\u001b[39m mus\u001b[57G be written \u001b[38;2;177;185;249m\\%\u001b[39m):\u001b[K\u001b[36;1H\u001b[34;3H\u001b[?25h"]
