onnection\u001b[65Gand\u001b[69Gprediction\u001b[80Gsettings.\r\u001b[13C\u001b[1B\u001b[38;2;177;185;249moutput/predictio\u001b[31Gs.csv\u001b[39m: one row per\u001b[50Gus\u001b[53Gr with \u001b[61Ghe pre\u001b[68Giction and its ra\u001b[87Ge\r\u001b[21C\u001b[1B\u001b[38;2;177;185;249mipeline.j\u001b[32Gon\u001b[39m: the saved\u001b[46Gs\u001b[48Gtup, ID \u001b[38;2;177;185;249mpipe_802639f9b93138b2\u001b[39m.\u001b[79G\u001b[K\r\u001b[20C\u001b[1B\u001b[38;2;177;185;249mbacktest\u001b[30Gc\u001b[32Gv\u001b[39m and \u001b[38;2;177;185;249mnori_rel_output/backt\u001b[60Gst_rows.csv\u001b[39m: the backtest\u001b[86Gresults,\u001b[95Gper\u001b[99Gmonth\u001b[105Gand\u001b[109Gper\u001b[113Guser.\r\u001b[20C\u001b[1B\u001b[38;2;177;185;249mcontext.csv\u001b[39m:\u001b[34Gthe\u001b[38Gpast examples Nori learned from.\u001b[K\r\u001b[4C\u001b[1BRerunning the saved setup for March 2\u001b[43Ggave exactly th\u001b[59G same\u001b[65G48 predictions.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWeekly job\u001b[14G\u001b[22m(Mondays\u001b[23Gat\u001b[26G06:00\u001b[32GUTC;\u001b[37Gin\u001b[40Ga\u001b[42Gcrontab,\u001b[51G\u001b[38;2;177;185;249m%\u001b[53G\u001b[39mmust\u001b[58Gbe\u001b[61Gwritten\u001b[69G\u001b[38;2;177;185;249m\\%\u001b[39m):\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B0\u001b[5G6\u001b[7G*\u001b[9G*\u001b[11G1\u001b[14G\u001b[36mcd\u001b[17G\u001b[39m/path/to/project\u001b[34G&&\u001b[37GD=$(\u001b[36mdate\u001b[46G\u001b[39m-u\u001b[49G-d\u001b[52Gyesterday\u001b[62G+\\%F)\u001b[68G&&\u001b[71G\\\r\u001b[2C\u001b[1B \u001b[5GHF_HUB_OFFLINE=1 python r\u001b[31Gfresh.py nori_rel_source.json pipeline.json\u001b[75G\\\r\u001b[4C\u001b[1B  --as-of \u001b[31m\"\u001b[39m$D\" --observed-through \u001b[31m\"\u001b[39m$D\" --task nori_rel_task.json \\\u001b[K\r\u001b[8C\u001b[1Bout \u001b[31m\"predictions_\u001b[39m$D.csv\" >> refresh.log 2>&1\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCopy\u001b[10G\u001b[38;2;177;185;249mr