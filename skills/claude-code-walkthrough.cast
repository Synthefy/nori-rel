[113.797987, "o", "\u001b[?25l\u001b[H\u001b[3G│                             │ from each user's own orders     │                                                │\r\u001b[2C\u001b[1B└─────────────────────────────┴─────────────────────────────────┴────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThes\u001b[8G are my assumptions:\u001b[K\r\u001b[4C\u001b[1BSpend means th\u001b[20G \u001b[38;2;177;185;249mamount\u001b[39m colum\u001b[34G a\u001b[37G it is: every\u001b[51Gorder counts and none are excluded.\r\u001b[2C\u001b[1B-\u001b[5GAll\u001b[9G48\u001b[12Gusers\u001b[18Gget\u001b[22Ga\u001b[24Gprediction,\u001b[36Gsince\u001b[42Gthey\u001b[47Gall\u001b[51Gexisted\u001b[59Gbefore\u001b[66Gthe\u001b[70Gstart\u001b[76Gdate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDo these dates and this query look right?\u001b[22m If you say\u001b[56Gyes, I'll run the prediction and\u001b[89Gthen\u001b[94Gthe\u001b[98Gbacktest.\u001b[108GChanges\u001b[116Gare\r\u001b[2C\u001b[1Bfine\u001b[8Gtoo,\u001b[13Gfor\u001b[17Gexample\u001b[25Ga\u001b[27Gcalendar\u001b[36Gmonth\u001b[42Ginstead\u001b[50Gof\u001b[53G30\u001b[56Gdays,\u001b[62Gor\u001b[65Ga\u001b[67Gdifferent\u001b[77Gstart\u001b[83Gdate.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 58s · done 5:59 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mYes, that is right. Spend is orders.amount, and users.created_at is when a user was created. Go ahead.\u001b[39m                \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mSkill\u001b[22m(nori-re\u001b[17G:backt\u001b[24Gst)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mSuccessfully\u001b[19Gloaded\u001b[26Gskill\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b