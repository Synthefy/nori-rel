6Great\r\u001b[4C\u001b[1Bthem as\u001b[13Goptimistic.\r\u001b[6C\u001b[1B\u001b[1mis rest\u001b[16Gon three months only.\u001b[22m Your ord\u001b[47Gr\u001b[49G start i\u001b[58G September\u001b[69G2\u001b[71G25, so \u001b[79Ghere isn't room for\u001b[99Gmore. The oldest t\u001b[118Gs\r\u001b[4C\u001b[1Blearned\u001b[13Gfrom da\u001b[21Ges with\u001b[29Galmost\u001b[36Gno\u001b[39Ghistory\u001b[47Gbefore\u001b[54Gthem,\u001b[60Gwhich\u001b[66Gpartly\u001b[73Gexplains\u001b[82Gits\u001b[86Glarger\u001b[93Gerror.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles\u001b[22m\u001b[K\r\u001b[2C\u001b[2BAll paths\u001b[13Gare\u001b[17Gin\u001b[20Gthis\u001b[25Gfolder:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mnori_rel_output/predictions.csv\u001b[39m:\u001b[38Gone\u001b[42Grow\u001b[46Gper\u001b[50Guser\u001b[55Gwith\u001b[60Gthe\u001b[64Gprediction\u001b[75Gand\u001b[79Gits\u001b[83Grange.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mnori_rel_output/pipeline.json\u001b[39m:\u001b[36Gthe\u001b[40Gsaved\u001b[46Gprediction\u001b[57Gsetup.\r\u001b[20C\u001b[1B\u001b[38;2;177;185;249mbacktest.c\u001b[32Gv\u001b[39m and\u001b[38G\u001b[38;2;177;185;249mnori_rel_output/backtest_rows.csv\u001b[39m: the backtest r\u001b[88Gsults,\u001b[95Gper\u001b[99Gmonth\u001b[105Gand\u001b[109Gper\u001b[113Guser.\r\u001b[20C\u001b[1B\u001b[38;2;177;185;249mcontext.csv\u001b[39m: the 192 past examples Nori learned\u001b[69Gfrom.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Greran the saved setup for the same date and got \u001b[54Gxactly\u001b[61Gthe same 48 predictions.\u001b[86GTo\u001b[89Gpredict\u001b[97Gfor\u001b[101Ga\u001b[103Gnew\u001b[107Gdate:\u001b[36;1H\u001b[34;3H\u001b[?25h"]
